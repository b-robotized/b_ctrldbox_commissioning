<launch>
  <arg name="start_rviz" default="false" description="Launch RViz visualization?"/>
  
  <arg name="configuration_package" default="b_robotized_franka_demo" description="The ROS package where we find the configuration files."/>
  
  <let name="controllers_yaml_dir" value="$(find-pkg-share b_robotized_franka_demo)/config"/>
  <node pkg="controller_manager" exec="ros2_control_node" name="b_controlled_box_cm" cwd="$(var controllers_yaml_dir)" output="both">
    <param from="$(var controllers_yaml_dir)/scenario_controllers_mock.yaml"/>
  </node>

  <include file="$(find-pkg-share $(var configuration_package))/launch/franka_bringup.launch.xml">
    <arg name="ros2_control_hardware_type" value="mock"/>
    <arg name="arm_prefix" value="fr3"/>
    <arg name="is_async" value="false"/>
  </include>

  <node if="$(var start_rviz)" pkg="rviz2" exec="rviz2" name="rviz2" output="both" args="-d $(find-pkg-share $(var configuration_package))/config/franka.rviz --ros-args --log-level fatal"/>

</launch>
