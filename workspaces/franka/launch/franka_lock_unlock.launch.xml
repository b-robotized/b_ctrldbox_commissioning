<launch>
    <!-- Launch Arguments with Defaults -->
    <arg name="hostname" default="10.50.50.1" /> <!-- Replace with the hostname -->
    <arg name="username" default="franka" /> <!-- Replace with the Username -->
    <arg name="password" default="franka123" /> <!-- Replace with your password -->
    <arg name="enable_relock" default="true" /> <!-- Relock the brakes on exit -->
    <arg name="wait_web_ui" default="true" /> <!-- Wait in case the robot web UI is currently in use -->
    <arg name="request_physical_access" default="true" /> <!-- Request control by confirming physical access to the robot in case the robot web UI is currently in use -->
    <arg name="enable_fci" default="true" /> <!-- Activate the FCI -->
    <arg name="robot_type" default="fr3" /> <!-- options: fr3, panda -->
    <arg name="log_level" default="debug" /> <!-- log level -->

    <include file="$(find-pkg-share franka_lock_unlock)/launch/franka_lock_unlock.launch.xml">
        <arg name="hostname" value="$(var hostname)" />
        <arg name="username" value="$(var username)" />
        <arg name="password" value="$(var password)" />
        <arg name="enable_relock" value="$(var enable_relock)" />
        <arg name="wait_web_ui" value="$(var wait_web_ui)" />
        <arg name="request_physical_access" value="$(var request_physical_access)" />
        <arg name="enable_fci" value="$(var enable_fci)" />
        <arg name="robot_type" value="$(var robot_type)" />
    </include>

</launch>
