<?xml version="1.0" encoding="UTF-8"?>

<robot name="franka" xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:arg name="robot_prefix" default="fr3"/>

    <xacro:include filename="$(find franka_description)/robots/common/franka_arm.srdf.xacro"/>
    <xacro:franka_arm_srdf 
            robot_type="fr3"
            hand="false"
            ee_id=""
            no_prefix="false"
            arm_prefix="$(arg robot_prefix)"/>

    <group_state name="home" group="$(arg robot_prefix)_arm">
        <joint name="$(arg robot_prefix)_joint1" value="0" />
        <joint name="$(arg robot_prefix)_joint2" value="-0.785398163397" />
        <joint name="$(arg robot_prefix)_joint3" value="0" />
        <joint name="$(arg robot_prefix)_joint4" value="-2.35619449019" />
        <joint name="$(arg robot_prefix)_joint5" value="0" />
        <joint name="$(arg robot_prefix)_joint6" value="1.57079632679" />
        <joint name="$(arg robot_prefix)_joint7" value="0.785398163397" />
    </group_state>

</robot>
