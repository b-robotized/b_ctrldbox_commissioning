<?xml version="1.0" encoding="UTF-8"?>

<robot name="franka" xmlns:xacro="http://wiki.ros.org/xacro">

    <!-- Prefix before the robot type: names <arm_prefix>fr3_joint1, hardware <arm_prefix>FrankaHardwareInterface -->
    <xacro:arg name="arm_prefix" default=""/>

    <xacro:include filename="$(find franka_description)/robots/common/franka_arm.srdf.xacro"/>
    <xacro:franka_arm_srdf
            robot_type="fr3"
            hand="false"
            ee_id=""
            no_prefix="false"
            arm_prefix="$(arg arm_prefix)"/>

    <group_state name="home" group="$(arg arm_prefix)fr3_arm">
        <joint name="$(arg arm_prefix)fr3_joint1" value="0" />
        <joint name="$(arg arm_prefix)fr3_joint2" value="-0.785398163397" />
        <joint name="$(arg arm_prefix)fr3_joint3" value="0" />
        <joint name="$(arg arm_prefix)fr3_joint4" value="-2.35619449019" />
        <joint name="$(arg arm_prefix)fr3_joint5" value="0" />
        <joint name="$(arg arm_prefix)fr3_joint6" value="1.57079632679" />
        <joint name="$(arg arm_prefix)fr3_joint7" value="0.785398163397" />
    </group_state>

</robot>
