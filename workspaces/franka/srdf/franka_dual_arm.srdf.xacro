<?xml version="1.0" encoding="UTF-8"?>

<robot name="franka_dual_arm" xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:include filename="$(find franka_description)/robots/common/franka_arm.srdf.xacro"/>
    <xacro:franka_arm_srdf
            robot_type="fr3"
            hand="false"
            no_prefix="false"
            arm_prefix="left_"/>

    <xacro:franka_arm_srdf
            robot_type="fr3"
            hand="false"
            no_prefix="false"
            arm_prefix="right_"/>

    <group name="dual_arm">
        <group name="left_fr3_arm"/>
        <group name="right_fr3_arm"/>
    </group>

    <group_state name="home" group="left_fr3_arm">
        <joint name="left_fr3_joint1" value="0" />
        <joint name="left_fr3_joint2" value="-0.785398163397" />
        <joint name="left_fr3_joint3" value="0" />
        <joint name="left_fr3_joint4" value="-2.35619449019" />
        <joint name="left_fr3_joint5" value="0" />
        <joint name="left_fr3_joint6" value="1.57079632679" />
        <joint name="left_fr3_joint7" value="0.785398163397" />
    </group_state>

    <group_state name="home" group="right_fr3_arm">
        <joint name="right_fr3_joint1" value="0" />
        <joint name="right_fr3_joint2" value="-0.785398163397" />
        <joint name="right_fr3_joint3" value="0" />
        <joint name="right_fr3_joint4" value="-2.35619449019" />
        <joint name="right_fr3_joint5" value="0" />
        <joint name="right_fr3_joint6" value="1.57079632679" />
        <joint name="right_fr3_joint7" value="0.785398163397" />
    </group_state>

</robot>
