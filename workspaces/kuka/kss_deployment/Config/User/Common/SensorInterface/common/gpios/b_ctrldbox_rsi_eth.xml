<ROOT>
  <CONFIG>
    <IP_NUMBER>10.23.23.28</IP_NUMBER>  <!-- IP-number of the external socket -->
      <PORT>28283</PORT>                <!-- Port-number of the external socket -->
      <SENTYPE>KROSHU</SENTYPE>         <!-- The name of your system send in <Sen Type="" > -->
      <ONLYSEND>FALSE</ONLYSEND>        <!-- TRUE means the client don't expect answers. Do not send anything to robot -->
  </CONFIG>
  <SEND>
    <ELEMENTS>
      <ELEMENT TAG="DEF_RIst"  TYPE="DOUBLE" INDX="INTERNAL" />  <!-- Cartesian position -->
      <ELEMENT TAG="DEF_AIPos" TYPE="DOUBLE" INDX="INTERNAL" />  <!-- Joint position -->
      <ELEMENT TAG="DEF_EIPos" TYPE="DOUBLE" INDX="INTERNAL" />  <!-- External axis position -->
      <ELEMENT TAG="DEF_Delay" TYPE="LONG"   INDX="INTERNAL" />  <!-- Number of late packets -->
      <!-- Digital inputs  ($IN[132]..$IN[139]) -->
      <ELEMENT TAG="GPIO.input_01" TYPE="BOOL" INDX="1"  />
      <ELEMENT TAG="GPIO.input_02" TYPE="BOOL" INDX="2"  />
      <ELEMENT TAG="GPIO.input_03" TYPE="BOOL" INDX="3"  />
      <ELEMENT TAG="GPIO.input_04" TYPE="BOOL" INDX="4"  />
      <ELEMENT TAG="GPIO.input_05" TYPE="BOOL" INDX="5"  />
      <ELEMENT TAG="GPIO.input_06" TYPE="BOOL" INDX="6"  />
      <ELEMENT TAG="GPIO.input_07" TYPE="BOOL" INDX="7"  />
      <ELEMENT TAG="GPIO.input_08" TYPE="BOOL" INDX="8"  />
    </ELEMENTS>
  </SEND>
  <RECEIVE>
    <ELEMENTS>
      <!-- Stop flag -->
      <ELEMENT TAG="Stop"  TYPE="BOOL"   INDX="1"  HOLDON="0" />
      <!-- Joint setpoints -->
      <ELEMENT TAG="AK.A1" TYPE="DOUBLE" INDX="2"  HOLDON="1" />
      <ELEMENT TAG="AK.A2" TYPE="DOUBLE" INDX="3"  HOLDON="1" />
      <ELEMENT TAG="AK.A3" TYPE="DOUBLE" INDX="4"  HOLDON="1" />
      <ELEMENT TAG="AK.A4" TYPE="DOUBLE" INDX="5"  HOLDON="1" />
      <ELEMENT TAG="AK.A5" TYPE="DOUBLE" INDX="6"  HOLDON="1" />
      <ELEMENT TAG="AK.A6" TYPE="DOUBLE" INDX="7"  HOLDON="1" />
      <!-- Digital outputs ($OUT[33]..$OUT[36]) -->
      <ELEMENT TAG="GPIO.output_01" TYPE="BOOL" INDX="8"  HOLDON="1" />
      <ELEMENT TAG="GPIO.output_02" TYPE="BOOL" INDX="9"  HOLDON="1" />
      <ELEMENT TAG="GPIO.output_03" TYPE="BOOL" INDX="10" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_04" TYPE="BOOL" INDX="11" HOLDON="1" />
      <!-- Digital outputs ($OUT[39]..$OUT[46]) -->
      <ELEMENT TAG="GPIO.output_05" TYPE="BOOL" INDX="12" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_06" TYPE="BOOL" INDX="13" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_07" TYPE="BOOL" INDX="14" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_08" TYPE="BOOL" INDX="15" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_09" TYPE="BOOL" INDX="16" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_10" TYPE="BOOL" INDX="17" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_11" TYPE="BOOL" INDX="18" HOLDON="1" />
      <ELEMENT TAG="GPIO.output_12" TYPE="BOOL" INDX="19" HOLDON="1" />
    </ELEMENTS>
  </RECEIVE>
</ROOT>
